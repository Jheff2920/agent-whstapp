# --- Servidor ---
PORT=3000
NODE_ENV=development
TIMEZONE=America/Lima
DB_PATH=./data/agent.db
KNOWLEDGE_DIR=./knowledge

# --- Modelo de lenguaje ---
# ollama = modelo local gratis | anthropic = Claude por API
LLM_PROVIDER=ollama
# Vacío = valor por defecto del proveedor (ollama: qwen2.5:7b-instruct, anthropic: claude-opus-5-5)
LLM_MODEL=
# Proveedor para resúmenes/aprendizaje (vacío = el mismo que LLM_PROVIDER)
LEARNING_PROVIDER=

OLLAMA_URL=http://127.0.0.1:11434
# Opcional: true/false para modelos con "thinking" (p. ej. qwen3). Vacío = no enviar.
OLLAMA_THINK=
OLLAMA_TIMEOUT_MS=180000

ANTHROPIC_API_KEY=
# low | medium | high  (esfuerzo de razonamiento; medium es buen balance para chat)
ANTHROPIC_EFFORT=medium
# Reintento automático en otro modelo si el principal rechaza por políticas de seguridad
ANTHROPIC_FALLBACKS=true

# --- n8n / WhatsApp ---
# Secreto compartido entre n8n y este servicio (cabecera X-Internal-Token)
INTERNAL_TOKEN=cambia-esto
# App Secret de tu app de Meta: valida la firma X-Hub-Signature-256
WA_APP_SECRET=
# Webhook de n8n que envía los mensajes por WhatsApp. Vacío = solo se registran en el log (modo desarrollo)
# Ejemplo: https://jheff2920.app.n8n.cloud/webhook/red-whatsapp-enviar
N8N_SEND_URL=

# Webhook de n8n que avisa a un asesor (correo) cuando una conversación se escala. Vacío = sin alertas
# Ejemplo: https://jheff2920.app.n8n.cloud/webhook/red-whatsapp-alerta
ALERT_URL=

# --- Panel web (bandeja de conversaciones) ---
# Puerto aparte del público: PANEL_HOST=127.0.0.1 solo desde este equipo; 0.0.0.0 para verlo desde la red local.
PANEL_PORT=3001
PANEL_HOST=127.0.0.1
# URL con la que abres el panel (se usa en los enlaces de las alertas), p. ej. http://192.168.1.50:3001
PANEL_URL=
# Contraseña del panel: usa ADMIN_PASSWORD_HASH (npm run hash-password) o, en pruebas, ADMIN_PASSWORD
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres para firmar la sesión (openssl rand -hex 32)
SESSION_SECRET=
# true si el panel se sirve por HTTPS
COOKIE_SECURE=

# --- Comportamiento ---
HISTORY_LIMIT=20
MAX_TOOL_ITERATIONS=6
DEBOUNCE_MS=1500
