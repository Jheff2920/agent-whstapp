# --- Servidor ---
PORT=3000
NODE_ENV=development
TIMEZONE=America/Lima
DB_PATH=./data/agent.db
KNOWLEDGE_DIR=./knowledge

# --- Modelo de lenguaje ---
# ollama = modelo local gratis | anthropic = Claude por API
LLM_PROVIDER=ollama
# Vacío = valor por defecto del proveedor (ollama: qwen2.5:7b-instruct, anthropic: claude-opus-5-5)
LLM_MODEL=
# Proveedor para resúmenes/aprendizaje (vacío = el mismo que LLM_PROVIDER)
LEARNING_PROVIDER=

OLLAMA_URL=http://127.0.0.1:11434
# Opcional: true/false para modelos con "thinking" (p. ej. qwen3). Vacío = no enviar.
OLLAMA_THINK=
OLLAMA_TIMEOUT_MS=180000

ANTHROPIC_API_KEY=
# low | medium | high  (esfuerzo de razonamiento; medium es buen balance para chat)
ANTHROPIC_EFFORT=medium
# Reintento automático en otro modelo si el principal rechaza por políticas de seguridad
ANTHROPIC_FALLBACKS=true

# --- WhatsApp: modo directo con la Cloud API de Meta (recomendado, sin n8n) ---
# Meta llama a https://TU-URL-PUBLICA/webhook y el cerebro envía por la Graph API. Ver deploy/README.md
# Token permanente de un usuario del sistema (Meta Business). El del panel de pruebas dura solo 24 h.
WA_ACCESS_TOKEN=
# ID del número de teléfono (Meta, WhatsApp, Configuración de la API)
WA_PHONE_NUMBER_ID=
# Texto que inventas tú y pegas en Meta al configurar el webhook (verificación)
WA_VERIFY_TOKEN=
# App Secret de tu app de Meta: valida la firma X-Hub-Signature-256 de cada mensaje (obligatorio en producción)
WA_APP_SECRET=
# Versión de la Graph API; revisa en el registro de cambios de Meta cuál está vigente
WA_GRAPH_VERSION=v23.0

# --- Alertas a asesores por Telegram (bot de @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Citas en tienda (opcional, ver deploy/README.md §6 y §7) ---
# Clave JSON de la cuenta de servicio de Google; los calendar_id de cada sede van en knowledge/sedes.yml.
# Guárdala fuera del repositorio (p. ej. ./secrets/google.json; la carpeta secrets/ está en .gitignore).
GOOGLE_SERVICE_ACCOUNT_FILE=
# Plantilla de WhatsApp aprobada por Meta para recordatorios cuando pasaron más de 24 h desde el último mensaje del cliente
WA_REMINDER_TEMPLATE=
WA_REMINDER_LANG=es

# --- Opcional: modo n8n (en vez de lo anterior). Ver n8n/README.md ---
# Secreto compartido con n8n (cabecera X-Internal-Token)
INTERNAL_TOKEN=
# Webhook de n8n que envía los mensajes por WhatsApp. Vacío = solo se registran en el log (modo desarrollo)
# Ejemplo: https://jheff2920.app.n8n.cloud/webhook/red-whatsapp-enviar
N8N_SEND_URL=
# Webhook de n8n que avisa a un asesor por correo (solo si no usas Telegram)
# Ejemplo: https://jheff2920.app.n8n.cloud/webhook/red-whatsapp-alerta
ALERT_URL=

# --- Panel web (bandeja de conversaciones) ---
# Puerto aparte del público: PANEL_HOST=127.0.0.1 solo desde este equipo; 0.0.0.0 para verlo desde la red local.
PANEL_PORT=3001
PANEL_HOST=127.0.0.1
# URL con la que abres el panel (se usa en los enlaces de las alertas), p. ej. http://192.168.1.50:3001
PANEL_URL=
# Contraseña del panel: usa ADMIN_PASSWORD_HASH (npm run hash-password) o, en pruebas, ADMIN_PASSWORD
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres para firmar la sesión (openssl rand -hex 32)
SESSION_SECRET=
# true si el panel se sirve por HTTPS
COOKIE_SECURE=

# --- Comportamiento ---
HISTORY_LIMIT=20
MAX_TOOL_ITERATIONS=6
DEBOUNCE_MS=1500
